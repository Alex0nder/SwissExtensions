{
  "manifest_version": 3,
  "name": "Swiss Command",
  "version": "1.0.0",
  "description": "Search open tabs, bookmarks, and browsing history from one private command palette.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "bookmarks", "history", "favicon"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Swiss Command",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open Swiss Command"
    }
  }
}
